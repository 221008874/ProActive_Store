{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/catalog", "schedule": "0 4 * * *" },
    { "path": "/api/cron/rollup", "schedule": "30 22 * * *" },
    { "path": "/api/cron/stuck-orders", "schedule": "0 6 * * *" },
    { "path": "/api/cron/notify", "schedule": "0 7 * * *" }
  ]
}