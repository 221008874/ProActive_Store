{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/api/health", "destination": "/api/[...path]?path=health" },
    { "source": "/api/catalog", "destination": "/api/[...path]?path=catalog" },
    { "source": "/api/product", "destination": "/api/[...path]?path=product" },
    { "source": "/api/cart/check", "destination": "/api/[...path]?path=cart/check" },
    { "source": "/api/coupon/preview", "destination": "/api/[...path]?path=coupon/preview" },
    { "source": "/api/geocode", "destination": "/api/[...path]?path=geocode" },
    { "source": "/api/placeOrder", "destination": "/api/[...path]?path=placeOrder" },
    { "source": "/api/reverse", "destination": "/api/[...path]?path=reverse" },
    { "source": "/api/og", "destination": "/api/[...path]?path=og" },
    { "source": "/api/robots", "destination": "/api/[...path]?path=robots" },
    { "source": "/api/sitemap", "destination": "/api/[...path]?path=sitemap" },
    { "source": "/api/admin/order/status", "destination": "/api/[...path]?path=admin/order/status" },
    { "source": "/api/admin/stock/adjust", "destination": "/api/[...path]?path=admin/stock/adjust" },
    { "source": "/api/admin/catalog/rebuild", "destination": "/api/[...path]?path=admin/catalog/rebuild" },
    { "source": "/api/admin/cloudinary/sign", "destination": "/api/[...path]?path=admin/cloudinary/sign" },
    { "source": "/api/admin/import", "destination": "/api/[...path]?path=admin/import" },
    { "source": "/api/admin/documents/download", "destination": "/api/[...path]?path=admin/documents/download" },
    { "source": "/api/admin/order/document/retry", "destination": "/api/[...path]?path=admin/order/document/retry" },
    { "source": "/api/cron/catalog", "destination": "/api/[...path]?path=cron/catalog" },
    { "source": "/api/cron/rollup", "destination": "/api/[...path]?path=cron/rollup" },
    { "source": "/api/cron/stuck-orders", "destination": "/api/[...path]?path=cron/stuck-orders" },
    { "source": "/api/cron/notify", "destination": "/api/[...path]?path=cron/notify" },
    { "source": "/robots.txt", "destination": "/api/[...path]?path=robots" },
    { "source": "/sitemap.xml", "destination": "/api/[...path]?path=sitemap" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/catalog", "schedule": "0 4 * * *" },
    { "path": "/api/cron/rollup", "schedule": "30 22 * * *" },
    { "path": "/api/cron/stuck-orders", "schedule": "0 6 * * *" },
    { "path": "/api/cron/notify", "schedule": "0 7 * * *" }
  ]
}