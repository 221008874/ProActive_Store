rules_version = '2';

// =============================================================================
// HARDENED rules for the fashion data model — NOT SAFE TO DEPLOY YET.
//
// Deploy order (each step depends on the one before it):
//   1. Deploy the /api routes with FIREBASE_SERVICE_ACCOUNT set, so the
//      server is the only writer of orders.
//   2. node scripts/setAdmin.mjs <admin-email>      (in ProActive_Admin)
//   3. that admin signs out and signs back in, so the claim is in their token
//   4. firebase deploy --only firestore:rules   (this file, as firestore.rules)
//
// isAdmin() requires request.auth.token.admin == true. Until the claim
// exists, EVERY admin write fails with permission-denied: saving products,
// confirming orders, editing coupons, updating shipping. You cannot fix it
// from the app - the dashboard simply stops saving.
//
// firestore.rules (the current file) is the safe baseline and the rollback
// target. To switch:
//   copy firestore.rules.baseline -> firestore.rules
//   firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Admins bypass every per-collection rule below.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ---- public reference data (read only) ----
    match /categories/{id}            { allow read: if true; }
    match /collections/{id}           { allow read: if true; }
    match /egp_governorate_costs/{id} { allow read: if true; }
    match /egp_settings/{id}          { allow read: if true; }
    match /size_guides/{id}           { allow read: if true; }

    // ---- catalog ----
    // Public read; writes are admin-only. The old rules let an authenticated
    // non-admin shrink stock as "part of placing an order" - that path is
    // gone now that /api/placeOrder writes with the Admin SDK, so no client
    // write of any kind can touch prices or stock.
    match /products_egp/{productId} {
      allow read: if true;

      match /variants/{variantId} {
        allow read: if true;
      }
    }

    // ---- coupons ----
    // CORRECTION 2: `type` is "percent" or "fixed"; existing docs are "fixed".
    // Exact-code get only - listing every coupon (and its usage counts) is not
    // public. `usedCount` is moved by the server (Admin SDK), not by clients.
    match /egp_coupons/{code} {
      allow get: if true;
    }

    // ---- orders ----
    // No public read: the storefront shows the receipt from router state,
    // not from Firestore. Create is OFF for clients - /api/placeOrder writes
    // with the Admin SDK after validating prices, stock and the coupon in
    // one transaction. Do not flip create back on without moving that
    // validation server-side.
    match /orders_egp/{orderId} {
      allow create: if false;
    }

    // Generated bills (tax invoices). The bytes live in a private GitHub
    // repository (see api/_core/githubStore.js); these rows are the index,
    // written by the server with the Admin SDK. Admin-only, like every
    // server-owned collection: they carry the customer's name, phone and
    // address. Covered by the admin bypass above; listed explicitly so the
    // contract is readable without hunting.
    match /orders_egp/{orderId}/order_documents/{docId} {
      allow read, write: if isAdmin();
    }

    // ---- server-owned collections ----
    // All written by the /api routes with the Admin SDK (which bypasses
    // rules) and readable only by admins. They hold anti-abuse state
    // (rate limits, blocklists, idempotency claims), the catalogue cache and
    // the audit trail, so nothing here is ever public.
    match /client_orders/{id}       { allow read, write: if isAdmin(); }
    match /recent_customers/{id}    { allow read, write: if isAdmin(); }
    match /rate_limits/{id}         { allow read, write: if isAdmin(); }
    match /blocklist/{id}           { allow read, write: if isAdmin(); }
    match /outbox/{id}              { allow read, write: if isAdmin(); }
    match /catalog_snapshots/{id}   { allow read, write: if isAdmin(); }
    match /stock_movements/{id}     { allow read, write: if isAdmin(); }
    match /stats_daily/{id}         { allow read, write: if isAdmin(); }
    match /geocode_cache/{id}       { allow read, write: if isAdmin(); }
    match /admin_logs/{id}          { allow read, write: if isAdmin(); }

    // ---- legacy, admin only ----
    match /mobile_orders/{id}         { allow read, write: if isAdmin(); }
    match /confirmedPayments_egp/{id} { allow read, write: if isAdmin(); }
    match /order_notifier/{id}        { allow read, write: if isAdmin(); }
  }
}