rules_version = '2';

// =============================================================================
// HARDENED rules for the fashion data model — NOT SAFE TO DEPLOY YET.
//
// DO NOT RUN:  firebase deploy --only firestore:rules
//
// until step 1 below has been completed:
//   1. node scripts/setAdmin.mjs <admin-email>      (in ProActive_Admin)
//   2. that admin signs out and signs back in, so the claim is in their token
//
// isAdmin() below requires request.auth.token.admin == true. Until the claim
// exists, EVERY admin write fails with permission-denied: saving products,
// confirming orders, editing coupons, updating shipping. You cannot fix it
// from the app - the dashboard simply stops saving.
//
// firestore.rules (the current file) is the safe baseline and the rollback
// target. To switch:
//   copy firestore.rules.baseline -> firestore.rules
//   firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Admins bypass every per-collection rule below.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ---- public reference data (read only) ----
    match /categories/{id}            { allow read: if true; }
    match /collections/{id}           { allow read: if true; }
    match /egp_governorate_costs/{id} { allow read: if true; }
    match /egp_settings/{id}          { allow read: if true; }

    // ---- catalog ----
    match /products_egp/{productId} {
      allow read: if true;

      // Non-admin updates may only ever shrink stock/counters, and only as
      // part of placing an order. Guards against a storefront inflating
      // stock or rewriting the price.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['soldCount', 'totalStock'])
                    && request.resource.data.soldCount > resource.data.soldCount
                    && request.resource.data.totalStock >= 0
                    && request.resource.data.totalStock < resource.data.totalStock;

      match /variants/{variantId} {
        allow read: if true;
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                      && request.resource.data.stock >= 0
                      && request.resource.data.stock < resource.data.stock;
      }
    }

    // ---- coupons ----
    // CORRECTION 2: `type` is "percent" or "fixed"; existing docs are "fixed".
    // Exact-code get only - listing every coupon (and its usage counts) is not
    // public. Redemption may only bump usedCount by one.
    match /egp_coupons/{code} {
      allow get: if true;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                    && request.resource.data.usedCount == resource.data.usedCount + 1;
    }

    // ---- orders ----
    // Create-only for customers, shape validated. No public read: the
    // storefront shows the receipt from router state, not from Firestore.
    match /orders_egp/{orderId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.adminConfirmed == false
                    && request.resource.data.paymentMethod == 'cod'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.customer.phone is string
                    && request.resource.data.customer.name is string
                    && request.resource.data.address.governorateId is string;
    }

    // ---- legacy, admin only ----
    match /mobile_orders/{id}         { allow read, write: if isAdmin(); }
    match /confirmedPayments_egp/{id} { allow read, write: if isAdmin(); }
    match /order_notifier/{id}        { allow read, write: if isAdmin(); }
  }
}